{
  "manifest_version": 3,
  "name": "Youtube Flex",
  "version": "0.5.2",
  "description": "Modern toolkit för YouTube-spelaren.",
  "incognito": "spanning",
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "action": {
    "default_title": "YT Flex",
    "default_popup": "Components/popup/popup.html",
    "default_icon": {
      "16": "assets/icon.png",
      "32": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts*",
        "https://m.youtube.com/watch*",
        "https://m.youtube.com/shorts*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/iframe_api*",
        "https://m.youtube.com/embed/*",
        "https://m.youtube.com/live_chat*",
        "https://m.youtube.com/iframe_api*"
      ],
      "js": [
        "Components/Buttons/YTP-Button/options.js",

        "Components/Buttons/YTP-Button/add-buttons-to-ymp/option-button-menu-design.js",

        "Components/Full-Window/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "resources": [
        "Components/Full-Window/content.css",

        "Components/Buttons/YTP-Button/add-buttons-to-ymp/ymp-position.css",
        "Components/Buttons/YTP-Button/add-buttons-to-ymp/ymp-full-window.css",
        "Components/Buttons/YTP-Button/add-buttons-to-ymp/ymp-full-window.js",

        "Components/Buttons/YTP-Button/design/option-popup.html",
        "Components/Buttons/YTP-Button/design/option-popup.css",
        "Components/Buttons/YTP-Button/design/option-popup.js",

        "Components/options-form/options-form.html",
        "Components/options-form/options-form.css",
        "Components/options-form/options-form.js",

        "Components/Dislikes/dislike.js",
        "Components/Dislikes/dislike.css",

        "Components/Print-screen/index.js",
        "Components/Print-screen/print-clipboard.js",
        "Components/Print-screen/tumbnail/downloadThumbnail.js",

        "Components/social-blade/index.js",
        "Components/zoom/zoom.js",

        "libs/ffmpeg/ffmpeg.min.js",
        "libs/ffmpeg/ffmpeg-core.js",
        "libs/ffmpeg/ffmpeg-core.wasm",

        "Components/video/video-download/sos-youtube.js",
        "Components/video/converter-mp3/index.js",

        "Components/hachtag-finder/hachtag-finder.js"
      ]
    }
  ]
}
